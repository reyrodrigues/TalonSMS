    "URL": "",
    "User": "",
    "Password": ""
  },
  "ActiveDirectory": {
    "Enabled": false,
    "AuthenticationUrl": "https://auth.rescue.org/SimpleAuthenticationRESTService.aspx",
    "EmailDomain": "theirc.org"
  },
  "Reports": {
    "PdfEngine": "Chromium"
  }
}
