{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "CreateAndSeedOnStartup": true,
    "SeedDemoData": true
